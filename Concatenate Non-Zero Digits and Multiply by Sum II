class Solution {

    static final int MOD = 1_000_000_007;

    public int[] sumAndMultiply(String s, int[][] queries) {

        int n = s.length();

        ArrayList<Integer> pos = new ArrayList<>();
        ArrayList<Integer> digit = new ArrayList<>();

        for (int i = 0; i < n; i++) {
            int d = s.charAt(i) - '0';
            if (d != 0) {
                pos.add(i);
                digit.add(d);
            }
        }

        int m = digit.size();

        long[] pow10 = new long[m + 1];
        pow10[0] = 1;
        for (int i = 1; i <= m; i++) {
            pow10[i] = (pow10[i - 1] * 10) % MOD;
        }

        long[] preNum = new long[m + 1];
        long[] preSum = new long[m + 1];

        for (int i = 0; i < m; i++) {
            preNum[i + 1] = (preNum[i] * 10 + digit.get(i)) % MOD;
            preSum[i + 1] = preSum[i] + digit.get(i);
        }

        int[] ans = new int[queries.length];

        for (int i = 0; i < queries.length; i++) {

            int l = queries[i][0];
            int r = queries[i][1];

            int left = lowerBound(pos, l);
            int right = upperBound(pos, r);

            if (left == right) {
                ans[i] = 0;
                continue;
            }

            int len = right - left;

            long x = (preNum[right] - preNum[left] * pow10[len]) % MOD;
            if (x < 0) x += MOD;

            long sum = preSum[right] - preSum[left];

            ans[i] = (int)((x * (sum % MOD)) % MOD);
        }

        return ans;
    }

    private int lowerBound(ArrayList<Integer> list, int target) {
        int l = 0, r = list.size();
        while (l < r) {
            int mid = (l + r) >>> 1;
            if (list.get(mid) >= target) r = mid;
            else l = mid + 1;
        }
        return l;
    }

    private int upperBound(ArrayList<Integer> list, int target) {
        int l = 0, r = list.size();
        while (l < r) {
            int mid = (l + r) >>> 1;
            if (list.get(mid) > target) r = mid;
            else l = mid + 1;
        }
        return l;
    }
}