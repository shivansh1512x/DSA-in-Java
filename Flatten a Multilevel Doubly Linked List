class Solution {

    public Node flatten(Node head) {
        if (head == null) return null;

        dfs(head);
        return head;
    }

    private Node dfs(Node node) {
        Node curr = node;
        Node last = null;

        while (curr != null) {
            Node next = curr.next;

            if (curr.child != null) {

                Node childHead = curr.child;
                Node childTail = dfs(childHead);

                curr.next = childHead;
                childHead.prev = curr;

                curr.child = null;

                if (next != null) {
                    childTail.next = next;
                    next.prev = childTail;
                }

                last = childTail;
                curr = childTail;
            } else {
                last = curr;
            }

            curr = curr.next;
        }

        return last;
    }
}
