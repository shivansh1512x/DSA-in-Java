class Solution {

    public int uniqueXorTriplets(int[] nums) {

        boolean[] present = new boolean[2048];

        // Mark distinct values
        for (int x : nums) {
            present[x] = true;
        }

        // All possible XOR of two values
        boolean[] pairXor = new boolean[2048];

        for (int a = 0; a < 2048; a++) {

            if (!present[a]) {
                continue;
            }

            for (int b = 0; b < 2048; b++) {

                if (present[b]) {
                    pairXor[a ^ b] = true;
                }
            }
        }

        // Add third value
        boolean[] result = new boolean[2048];

        for (int x = 0; x < 2048; x++) {

            if (!pairXor[x]) {
                continue;
            }

            for (int a = 0; a < 2048; a++) {

                if (present[a]) {
                    result[x ^ a] = true;
                }
            }
        }

        int count = 0;

        for (boolean possible : result) {
            if (possible) {
                count++;
            }
        }

        return count;
    }
}
