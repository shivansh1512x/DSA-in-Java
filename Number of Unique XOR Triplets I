class Solution {

    public int uniqueXorTriplets(int[] nums) {

        int n = nums.length;

        // n = 1 -> {1}
        if (n == 1) {
            return 1;
        }

        // n = 2 -> {1, 2}
        if (n == 2) {
            return 2;
        }

        // n >= 3
        int ans = 1;

        while (ans <= n) {
            ans <<= 1;
        }

        return ans;
    }
}
