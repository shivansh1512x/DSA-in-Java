class Solution {
    public int[] findMissingAndRepeatedValues(int[][] grid) {
        int n= grid.length;
        int total = n*n;
        int[] count = new int[total+1];

        for(int i =0; i<n; i++){
            for(int j=0; j<n; j++){
                count[grid[i][j]]++;
            }
        }
        int repeated = 1;
        int missing = -1;

        for(int num=1; num<=total; num++){
            if(count[num]==2) repeated = num;
            if(count[num]==0) missing = num;
        }
        return new int[] {repeated,missing};
    }
}
